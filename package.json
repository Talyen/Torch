{
  "name": "torch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:build": "node scripts/process-assets.mjs",
    "dev": "npm run assets:build && vite",
    "build": "npm run assets:build && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:e2e -- --reporter=line"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "phaser": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
